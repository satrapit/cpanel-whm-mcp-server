# Copy to .env for local development; the process does not load .env automatically.
HOST=127.0.0.1
PORT=3000
PUBLIC_MCP_URL=http://127.0.0.1:3000/mcp
# Required: established OIDC authorization server (HTTPS only).
OIDC_ISSUER=https://identity.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Do not configure upstream cPanel or WHM secrets here.
